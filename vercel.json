{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/auth/google/callback", "destination": "/api/auth/google/callback" },
    { "source": "/api/auth/linkedin/callback", "destination": "/api/auth/linkedin/callback" },
    { "source": "/api/(.*)", "destination": "/api?path=$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "env": {
    "SQLITE_PATH": "/tmp/cvmora.db"
  }
}
