# Optional: JWT secret for session tokens (defaults to dev value if unset)
# JWT_SECRET=your-secret-here

# OAuth: create account / sign in with Google and LinkedIn
# Get credentials from Google Cloud Console and LinkedIn Developer Portal.
# Redirect URIs to configure:
#   Google:  https://your-api-domain.com/api/auth/google/callback  (or http://localhost:3001/api/auth/google/callback for dev)
#   LinkedIn: same path /api/auth/linkedin/callback
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3001

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Welcome email (optional): send a welcome email when a user creates an account.
# If not set, registration still works; no email is sent.
# Example for Gmail: use an App Password (not your normal password).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM=noreply@cvmora.com

# Stripe: payments and subscriptions
# Get keys from https://dashboard.stripe.com/apikeys
#
# To set up subscription pricing:
# 1. Go to Products in your Stripe Dashboard
# 2. Create a product (e.g. "Cvmora Pro")
# 3. Add two recurring prices: one monthly, one yearly
# 4. Copy each Price ID (price_xxx) below
#
# STRIPE_PRICE_ID is the legacy fallback (used if monthly/yearly aren't set).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=
