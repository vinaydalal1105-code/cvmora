{
  "name": "cvmora",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npx --yes concurrently \"npm run server\" \"npm run dev:client\" --names api,vite",
    "dev:client": "vite",
    "dev:all": "npm run dev",
    "build": "tsc -b && vite build",
